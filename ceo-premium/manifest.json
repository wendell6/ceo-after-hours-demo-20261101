      "sha256": "b0e6e8ed9ed81d7c33faba32983ded0c15abd9cc7933da3b8407826e380d2273"
    },
    "coffee1": {
      "text": "咖啡不错。你的提议，我再考虑一下。",
      "file": "ceo-premium/audio/coffee1.mp3",
