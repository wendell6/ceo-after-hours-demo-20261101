      "seed": 20261102,
      "sha256": "107d806618ed54fd990d954018f714a19c23127605bd966a1e554c135411c0e9"
    },
    "coffee2": {
      "text": "这杯子，比我的野心还大。",
      "file": "ceo-premium/audio/coffee2.mp3",
      "duration": 3.22,
      "seed": 20261103,
      "sha256": "52e1dda37a283fd955ea02f7b38c6b3f0df630dd576971637be3a9dfb3d32b86"
    },
    "coffee3": {
      "text": "行。今晚不睡的，原来是我。",
      "file": "ceo-premium/audio/coffee3.mp3",
      "duration": 4.9,
      "seed": 20261104,
      "sha256": "047d4b5924b6c57dc6df1cb5875a2c46261d4c9220d1beff3e560de68606f277"
    },
    "wind1": {
      "text": "谁开的风？我的发型，有自己的想法。",
      "file": "ceo-premium/audio/wind1.mp3",
      "duration": 5.32,
      "seed": 20261105,
      "sha256": "60f8ca1a50510220fa65c9abeb7b17dc1551cf898243907dd2de796515bf9e6b"
    },
    "wind2": {
      "text": "别吹了。报表真的要起飞了。",
      "file": "ceo-premium/audio/wind2.mp3",
      "duration": 3.72,
      "seed": 20261106,
      "sha256": "ccec7e3e384700b1f6977df1586ef43cf0c0693f335f1b1b664a9fe42ea60f2d"
    },
    "wind3": {
      "text": "行了，报表先下班。你们也下班！",
      "file": "ceo-premium/audio/wind3.mp3",
      "duration": 3.52,
      "seed": 20261107,
      "sha256": "8f3c21b288bfa15eda2e9e2495dd77561ce22b3571595259841131933a19aad6"
    },
    "party1": {
      "text": "上班时间，谁批准放礼花的？",
      "file": "ceo-premium/audio/party1.mp3",
