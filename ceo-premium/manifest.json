      "seed": 20261108,
      "sha256": "750dce15d4130ca4ada8a9b2076583a9344c35675ff719b8059a30cb2f97b625"
    },
    "party3": {
      "text": "别录！这段，绝对不能发公司群！",
      "file": "ceo-premium/audio/party3.mp3",
      "duration": 3.446417,
